# ===== LLM（OpenAI 协议兼容端点）=====
# DeepSeek（默认，便宜且支持 function calling）
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 也可以用 OpenAI / 本地 Ollama，只需改下面三行：
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ===== Embedding（检索层语义路，可选增强）=====
# 留空则检索层走纯 BM25 词法路（行为与历史版本一致，全部单测与 CI 都在这一模式）。
# 配了才会启用「bigram BM25 + Embedding + RRF + 两路一致性」混合检索。
# 默认指向阿里百炼兼容模式；DeepSeek 不提供 embedding 模型，别填它的 Key。
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
# 若报 403 `AllocationQuota.FreeTierOnly`，说明该模型免费额度已用尽且「用完即停」开着。
# 优先换模型而不是去关那个开关（关了就是按量付费）。实测可用备选：
#   EMBED_MODEL=qwen3.7-text-embedding          # 向量模型，有独立免费额度
#   EMBED_MODEL=qwen3.7-text-embedding-flash    # 同上，更快
# 额度与开关状态查询：百炼控制台 → 费用用量 → 免费额度 → 搜模型 code。
# 离线调试混合链路结构时用（字符哈希向量，**不具备语义能力**，不得据此宣称检索质量）
# EMBED_BACKEND=hashing

# ===== 数据库 =====
DATABASE_URL=sqlite:///./learning_agent.db

# ===== 应用 =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ===== 账号体系 JWT 密钥 =====
# 不填则每次启动随机生成（重启后旧登录态失效）
JWT_SECRET=

# ===== 腾讯云短信（SMS）=====
# 5 项全部填了才会真实下发；缺任意一项自动降级为「演示模式」
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SMS_SDK_APP_ID=
# 需先在腾讯云控制台申请并通过审核的签名
TENCENTCLOUD_SMS_SIGN_NAME=学习助手
TENCENTCLOUD_SMS_TEMPLATE_ID=
TENCENTCLOUD_SMS_REGION=ap-guangzhou
# 设 1 只打印将要发送的请求体，不真正调用（不扣费）
SMS_DRY_RUN=0

# ===== 邮件（SMTP）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== 微信 / QQ 开放平台（未配置则 mock 扫码）=====
# 注意：真实微信/QQ 登录需企业资质，个人开发者通常申请不到
WECHAT_APPID=
WECHAT_SECRET=
QQ_APPID=
QQ_SECRET=
QQ_REDIRECT=
